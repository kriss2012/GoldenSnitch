     }
    },
    "type": "object",
    "required": [
     "player_id"
    ],
    "title": "MemberIn"
   },
   "RosterIn": {
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 60,
      "minLength": 2,
      "title": "Name"
     },
     "game": {
      "type": "string",
      "title": "Game"
     }
    },
    "type": "object",
    "required": [
     "name",
     "game"
    ],
    "title": "RosterIn"
   },
   "ScoutIn": {
    "properties": {
     "roster_id": {
      "type": "integer",
      "title": "Roster Id"
     },
     "role": {
      "type": "string",
      "title": "Role"
     },
     "top_n": {
      "type": "integer",
      "maximum": 50.0,
      "minimum": 1.0,
      "title": "Top N",
      "default": 10
     },
     "min_matches": {
      "type": "integer",
      "minimum": 0.0,
      "title": "Min Matches",
      "default": 0
     },
     "weights": {
      "anyOf": [
       {
        "additionalProperties": {
         "type": "number"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Weights"
     },
     "fit_weights": {
      "anyOf": [
       {
        "additionalProperties": {
         "type": "number"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fit Weights"
     },
     "focus_dimensions": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Focus Dimensions"
     },
     "sort": {
      "type": "string",
      "title": "Sort",
      "default": "role_score"
     }
    },
    "type": "object",
    "required": [
     "roster_id",
     "role"
    ],
    "title": "ScoutIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
