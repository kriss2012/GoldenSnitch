# ==============================================================================
# Golden Snitch — Production Environment Configuration (.env)
# ==============================================================================

# Core Application Settings
APP_ENV=production
DEBUG=false
APP_NAME="Golden Snitch Esports Scouting & Roster Intelligence"
API_PREFIX=/api/v1

# Security & Secrets (Must be changed in production!)
# Generate with: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_hex(32))"
SCOUTGRID_SECRET_KEY=generate_a_secure_random_64_character_hex_key_here

# Database Configuration (Persistent SQLite with WAL mode)
SCOUTGRID_DB=/app/data/scoutgrid.db

# Domain & CORS Origins (Comma-separated)
FRONTEND_ORIGIN=https://app.goldensnitch.gg
ALLOWED_ORIGINS=https://app.goldensnitch.gg,https://goldensnitch.gg

# Live Esports Telemetry API Keys (Optional in dev/mock mode; recommended for live production sync)
HENRIK_API_KEY="HDEV-5d855473-1268-4e32-9dab-b03303024296"
VALORANT_API_KEY="HDEV-5d855473-1268-4e32-9dab-b03303024296"
STEAM_WEB_API_KEY=
PANDASCORE_API_KEY=

# Reverse Proxy & Host Port Binding
PORT=8000
FRONTEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

Api Vslvorant="HDEV-5d855473-1268-4e32-9dab-b03303024296"